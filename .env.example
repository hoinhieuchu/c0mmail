APP_ENV=production
APP_DEBUG=false
APP_URL=https://mail.example.com
APP_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64
APP_SESSION_NAME=c0mmail_session
# Enable only when REMOTE_ADDR is the real client IP, not a shared reverse proxy.
LOGIN_RATE_LIMIT_IP_WIDE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=c0mmail
DB_USERNAME=c0mmail_user
DB_PASSWORD=
MAIL_PROVIDER=manual
MAIL_DOMAIN=example.com
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=starttls
MAIL_SMTP_TIMEOUT=20
# Keep false in production; only enable for isolated private test relays.
MAIL_ALLOW_INSECURE_AUTH=false
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION=ssl
MAIL_IMAP_TIMEOUT=20
MAIL_PAGE_SIZE=25
MAIL_ATTACHMENT_MAX_BYTES=10485760
MAIL_ATTACHMENT_TOTAL_MAX_BYTES=20971520
# Optional exact IMAP folder names; leave blank for common-name detection.
MAIL_FOLDER_INBOX=INBOX
MAIL_FOLDER_SENT=
MAIL_FOLDER_DRAFTS=
MAIL_FOLDER_SPAM=
MAIL_FOLDER_TRASH=
